{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "severity", "summary", "failure_scenario"],
        "properties": {
          "file": {"type": "string", "description": "Repo-relative path"},
          "line": {"type": "integer", "minimum": 1},
          "severity": {"enum": ["important", "pre_existing", "nit"]},
          "summary": {"type": "string", "description": "Statement of the defect"},
          "failure_scenario": {"type": "string", "description": "Concrete inputs/state -> wrong output/crash"}
        }
      }
    }
  }
}
